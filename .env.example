# ──────────────────────────────────────────────
# iProject — Environment Template (copy to .env)
# NEVER commit real .env with secrets
# ──────────────────────────────────────────────

# Runtime
PMS_ENV=development
FLASK_APP=app.py
FLASK_DEBUG=1
HOST=127.0.0.1
PORT=5000

# CRITICAL: use a long random string in production
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-secure-secret-key

# Database
# Dev (SQLite):
SQLALCHEMY_DATABASE_URI=sqlite:///instance/pms.db
# Production (PostgreSQL) — preferred:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/iproject

# Auto-create missing tables (dev=1, production prefer Alembic + PMS_AUTO_CREATE_DB=0)
PMS_AUTO_CREATE_DB=1
AUTO_DB_UPGRADE=1

# Owner / platform admin email
OWNER_EMAIL=you@example.com

# Branding
APP_NAME=iProject
APP_YEAR=۱۴۰۴

# Pagination
PER_PAGE=20

# Session
REMEMBER_COOKIE_DAYS=30

# SMS (optional — leave empty to disable)
# SMS_PROVIDER=kavenegar
# SMS_API_KEY=
# SMS_SENDER=

# Email (optional)
# MAIL_SERVER=smtp.example.com
# MAIL_PORT=587
# MAIL_USE_TLS=1
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=noreply@example.com
DEV_EMAIL_CONSOLE=1

# Logs
# PMS_LOG_DIR=/var/log/iproject
